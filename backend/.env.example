# ==============================================================================
# FinTrack Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (no trailing slash)
# In local development: defaults to localhost:3000
# In production, set this to your exact deployed frontend domain:
# e.g., FRONTEND_URL=https://fintrack.example.com
FRONTEND_URL=

# Supabase Project URL
# Get this from: Supabase Dashboard → Project Settings → API → Project URL
# e.g., https://xyzcompanyproject.supabase.co
SUPABASE_URL=

# Supabase Anon Public Key
# Get this from: Supabase Dashboard → Project Settings → API → Project API Keys (anon / public)
SUPABASE_ANON_KEY=

# Supabase Secret / Service Role Key
# IMPORTANT: This secret must ONLY exist on the backend.
# NEVER expose this value in client-side code, Git commits, or public URLs.
# Get this from: Supabase Dashboard → Project Settings → API → Project API Keys (service_role / secret)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
