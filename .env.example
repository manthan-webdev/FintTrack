# ==============================================================================
# FinTrack Full-Stack Environment Variables
# IMPORTANT: Never commit actual secret keys to source control.
# ==============================================================================

# Application Port
PORT=3000

# Backend Node Environment
NODE_ENV=development

# Allowed Frontend URL for Backend CORS
# Local development: http://localhost:3000
# Production: Set to your deployed application domain (e.g., https://fintrack.example.com)
FRONTEND_URL=

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------

# Frontend Public Variables (Safe for browser)
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# Application URL for Supabase Auth Redirects (Password Reset, Email Confirmation)
# In production: Set to your canonical domain (e.g., https://fintrack.example.com)
# In local development: Defaults to current window.location.origin (e.g., http://localhost:3000)
VITE_APP_URL=

# Backend Server Variables (Keep secret - NEVER expose to browser)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
