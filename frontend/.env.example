# ==============================================================================
# FinTrack Frontend Client Environment Variables
# ==============================================================================

# Supabase Project URL
# Get this from: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase Anonymous Public Key
# Safe for browser/client-side code.
# Get this from: Supabase Dashboard → Project Settings → API → Project API Keys (anon / public)
VITE_SUPABASE_ANON_KEY=

# Backend REST API URL
# Leave empty for same-origin relative URLs (/api) when running fullstack.
# When deployed independently (e.g. Vercel), set to your backend domain:
# e.g., VITE_API_URL=https://api.fintrack.example.com
VITE_API_URL=

# Canonical Application URL for Supabase Auth Redirects (Password Reset, Email Confirmation)
# In production: Set to your canonical domain (e.g., https://fintrack.example.com)
# In local development: Defaults automatically to current browser window.location.origin
VITE_APP_URL=
